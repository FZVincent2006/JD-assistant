{
  "manifest_version": 3,
  "name": "招聘 JD 发布助手",
  "description": "解析招聘 JD，填入 Boss 直聘或脉脉招聘表单。",
  "version": "0.3.16",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.zhipin.com/*",
    "https://*.kanzhun.com/*",
    "https://maimai.cn/*",
    "https://*.maimai.cn/*",
    "https://maimai.com/*",
    "https://*.maimai.com/*"
  ],
  "action": {
    "default_title": "打开招聘 JD 发布助手"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://*.kanzhun.com/*",
        "https://maimai.cn/*",
        "https://*.maimai.cn/*",
        "https://maimai.com/*",
        "https://*.maimai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
